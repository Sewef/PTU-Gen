{
  "name": "ptu-pokemon-generator",
  "version": "1.0.0",
  "description": "Pokemon Team Unlimited 1.05 Pokemon Generator API",
  "main": "server.js",
  "scripts": {
    "build": "npm run build:owlbear",
    "build:owlbear": "esbuild src/owlbear.js --bundle --minify --format=iife --platform=browser --outfile=public/owlbear.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:api": "node test_api_comprehensive.js"
  },
  "keywords": [
    "ptu",
    "pokemon",
    "generator",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@owlbear-rodeo/sdk": "^3.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "hono": "^4.12.27",
    "watch": "^1.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "nodemon": "^3.0.2",
    "wrangler": "^4.105.0"
  },
  "engines": {
    "node": "18.x"
  }
}
