{
  "name": "ptu-pokemon-generator",
  "version": "1.0.0",
  "description": "Pokemon Team Unlimited 1.05 Pokemon Generator API",
  "main": "server.js",
  "scripts": {
    "build": "npm run build:owlbear && vite build && node scripts/verify-owlbear-build.mjs",
    "build:owlbear": "esbuild src/owlbear.js --bundle --minify --format=iife --platform=browser --outfile=public/owlbear.js",
    "prestart": "npm run build",
    "start": "node server.js",
    "dev": "vite",
    "dev:api": "nodemon server.js",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:api": "node tests/test.js"
  },
  "keywords": [
    "ptu",
    "pokemon",
    "generator",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@owlbear-rodeo/sdk": "^3.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "hono": "^4.12.27"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "esbuild": "^0.25.12",
    "jsdom": "^24.1.3",
    "nodemon": "^3.0.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wrangler": "^4.105.0"
  },
  "engines": {
    "node": ">=18.18"
  }
}
